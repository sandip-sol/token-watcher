{
  "name": "tokenwatcher",
  "version": "0.1.0",
  "description": "Open-source LLM cost & token usage auditor. Self-hosted, privacy-first.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sdk": "npm --workspace @tokenwatcher/sdk run test",
    "test:sdk:ingest": "ts-node --esm test-sdk.ts",
    "build:sdk": "npm --workspace @tokenwatcher/sdk run build",
    "typecheck:sdk": "npm --workspace @tokenwatcher/sdk run typecheck",
    "test:all": "npm run test && npm run test:sdk",
    "build:all": "npm run build:sdk && npm run build",
    "typecheck:all": "npm run typecheck && npm run typecheck:sdk",
    "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:backfill:workspaces": "ts-node scripts/backfill-workspaces.ts",
    "db:rebuild-rollups": "tsx scripts/rebuild-rollups.ts",
    "db:seed": "npx ts-node prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "token",
    "cost",
    "monitoring",
    "observability",
    "self-hosted",
    "open-source",
    "analytics"
  ],
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}
