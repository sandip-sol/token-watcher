# ──────────────────────────────────────────────────────────────
# TokenWatcher — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://tokenwatcher:tokenwatcher@localhost:5432/tokenwatcher"
# Used by Prisma migrations. For local Docker, this can match DATABASE_URL.
# For Supabase, use the Direct connection URL, not the pooler URL.
DIRECT_URL="postgresql://tokenwatcher:tokenwatcher@localhost:5432/tokenwatcher"

# ── Dashboard Auth ────────────────────────────────────────────
DASHBOARD_AUTH_ENABLED="true"
DASHBOARD_USERNAME="admin"
DASHBOARD_PASSWORD="change_me_in_production"
DASHBOARD_SESSION_SECRET="replace_with_long_random_secret"
DASHBOARD_SESSION_COOKIE_NAME="tokenwatcher_session"
# Optional. Falls back to DASHBOARD_SESSION_SECRET when empty.
CSRF_SECRET=""

# Legacy fallback used only if DASHBOARD_SESSION_SECRET is unset.
# Generate secrets with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── API Keys ──────────────────────────────────────────────────
# This key is used by the SDK to authenticate ingest requests.
# Set it to anything secret and pass it to your SDK config.
TOKENWATCHER_API_KEY="tw_dev_key_change_me_in_production"

# ── Ingest Security ───────────────────────────────────────────
INGEST_RATE_LIMIT_ENABLED="true"
INGEST_RATE_LIMIT_WINDOW_SECONDS="60"
INGEST_RATE_LIMIT_MAX_REQUESTS="120"
INGEST_MAX_BATCH_SIZE="100"
# Unsafe for public production use. Keep false so ingest cost is calculated server-side.
ALLOW_INGEST_COST_OVERRIDE="false"
# Comma-separated origins allowed to call /api/ingest from browsers.
# Leave empty for same-origin and server-to-server requests.
INGEST_ALLOWED_ORIGINS=""

# ── Security Headers / CSP ───────────────────────────────────
# Set to "true" while testing a new production CSP.
CSP_REPORT_ONLY="false"
# Comma-separated extra connect-src origins. "*" is ignored.
CSP_CONNECT_SRC=""

# ── Alerts (optional) ─────────────────────────────────────────
CRON_SECRET=""
ALERT_COOLDOWN_MINUTES="60"
ALERT_WEBHOOK_TIMEOUT_MS="5000"
ALERT_USE_ROLLUPS="true"
SLACK_WEBHOOK_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
ALERT_EMAIL_FROM="alerts@yourdomain.com"

# ── Feature flags ─────────────────────────────────────────────
# Set to "true" to store prompt/completion text in the database
STORE_PROMPTS="false"
ROLLUPS_ENABLED="true"
ROLLUP_REBUILD_SECRET=""

# ── Node ──────────────────────────────────────────────────────
NODE_ENV="development"
