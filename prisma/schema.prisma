// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model LLMEvent {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  // Model info
  provider    String   // "openai" | "anthropic" | "google" | "ollama" | "custom"
  model       String   // "gpt-4o" | "claude-sonnet-4-20250514" etc.

  // Event state
  eventType   String   @default("usage")
  status      String?
  errorType   String?
  errorMessage String? @db.Text

  // Usage
  inputTokens  Int
  outputTokens Int
  totalTokens  Int      @default(0)

  // Cost (stored in USD, calculated at ingest time)
  inputCostUsd  Float   @default(0)
  outputCostUsd Float   @default(0)
  totalCostUsd  Float   @default(0)

  // Performance
  latencyMs   Int?
  requestId   String?
  userId      String?

  // Tagging — stored as flat key-value for easy filtering
  tags        Json     @default("{}")

  // Optional: store request/response for debugging (can be disabled)
  prompt      String?  @db.Text
  completion  String?  @db.Text

  @@index([createdAt])
  @@index([workspaceId])
  @@index([projectId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, projectId, createdAt])
  @@index([workspaceId, provider, createdAt])
  @@index([workspaceId, model, createdAt])
  @@index([workspaceId, eventType, createdAt])
  @@index([provider])
  @@index([model])
}

model DailyUsageRollup {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String   @default("__all__")
  date           DateTime

  provider       String   @default("__all__")
  model          String   @default("__all__")

  totalCostUsd   Float    @default(0)
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  totalTokens    Int      @default(0)
  requestCount   Int      @default(0)
  errorCount     Int      @default(0)
  totalLatencyMs Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, projectId, date, provider, model])
  @@index([workspaceId, date])
  @@index([workspaceId, projectId, date])
  @@index([provider])
  @@index([model])
}

model HourlyUsageRollup {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String   @default("__all__")
  hour           DateTime

  provider       String   @default("__all__")
  model          String   @default("__all__")

  totalCostUsd   Float    @default(0)
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  totalTokens    Int      @default(0)
  requestCount   Int      @default(0)
  errorCount     Int      @default(0)
  totalLatencyMs Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, projectId, hour, provider, model])
  @@index([workspaceId, hour])
  @@index([workspaceId, projectId, hour])
}

model ModelPricing {
  id              String   @id @default(cuid())
  provider        String
  model           String
  inputPer1MTokens  Float  // USD per 1M input tokens
  outputPer1MTokens Float  // USD per 1M output tokens
  updatedAt       DateTime @updatedAt

  @@unique([provider, model])
}

model AlertRule {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name            String
  type            String
  threshold       Float
  provider        String?
  model           String?
  webhookUrl      String?
  isActive        Boolean  @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  history         AlertHistory[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([type])
  @@index([isActive])
}

model AlertHistory {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String?
  alertRuleId String
  alertRule   AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  triggeredAt DateTime  @default(now())
  type        String
  value       Float
  threshold   Float
  status      String
  message     String?
  error       String?

  @@index([workspaceId])
  @@index([projectId])
  @@index([alertRuleId])
  @@index([triggeredAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name        String?
  keyPrefix   String
  keyHash     String    @unique
  environment String    @default("live")
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([workspaceId])
  @@index([projectId])
  @@index([keyPrefix])
  @@index([isActive])
}

model Workspace {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projects  Project[]
  apiKeys   ApiKey[]
  events    LLMEvent[]
  alerts    AlertRule[]
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  environment String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  apiKeys     ApiKey[]
  events      LLMEvent[]
  alerts      AlertRule[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}
